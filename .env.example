TRADING_MODE=paper

# Alpaca (get keys at: alpaca.markets)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Adanos Market Sentiment API  (get at: adanos.com or marketsentiment.co)
ADANOS_API_KEY=your_adanos_api_key_here
# Base URL from your Adanos dashboard - check their API docs for the correct endpoint
ADANOS_BASE_URL=https://api.adanossentiment.com

# Finnhub (optional, not used in v1; yfinance used instead for analyst consensus)
# FINNHUB_API_KEY=your_finnhub_api_key_here

# Slack: signal alerts and interactive approve/reject buttons
# Create a Slack App at api.slack.com/apps, enable Socket Mode and Interactivity.
# Bot token scopes needed: chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# App-level token (xapp-...) from Settings → Socket Mode in your Slack App.
# Required for interactive Approve/Reject buttons. Leave blank to disable buttons.
SLACK_APP_TOKEN=xapp-your-app-token-here
# Channel ID (not name) where trade alerts are posted (e.g. C0123456789)
SLACK_CHANNEL_ID=your-channel-id-here

# SQLite database path (relative to repo root)
DB_PATH=trading_system.db

# Agent settings
AGENT_TIMEZONE=America/New_York

# Approval mode: false = auto-execute; true = notify-only, await manual confirmation
REQUIRE_APPROVAL=false
